# SMTP configuration for the /api/contact route handler.
# When ALL of these are set, contact form submissions are emailed via
# nodemailer. When any are missing, submissions are simply logged
# server-side and the API still responds with success (see
# app/api/contact/route.ts for details) — useful for local development
# without a real mail server.

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Google Places API — powers the live Google reviews section on the homepage.
# When either is missing, that section falls back to a static "read our
# reviews" prompt instead of failing the build.
# Get an API key at https://console.cloud.google.com (enable "Places API").
# Find your Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Static rating fallback (shown until the API key above is set) and the
# Facebook review URL both live in lib/review-ratings.ts, not here.

# Root URL of your WordPress site. Blog posts are fetched directly from
# WordPress's own built-in REST API (<WP_SITE_URL>/wp-json/wp/v2/posts) —
# no custom backend needed. Powers the blog listing page, single post
# pages, and the homepage blog preview. When unset, those fall back to a
# "coming soon" state / don't render at all instead of failing the build.
WP_SITE_URL=

# Base URL of the custom WordPress portfolio/case-studies API (see the
# wp-api/ folder at the repo root — upload its contents to the document
# root of a subdomain such as app.yourdomain.com and fill in
# wp-api/config.php first). Powers the portfolio listing page, single
# case-study pages, and the homepage case-study preview.
WP_API_BASE_URL=
